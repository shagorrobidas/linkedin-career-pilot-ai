# ==============================================================================
# LinkedInCareerPilot AI - Environment Configuration
# ==============================================================================

# Application Environment: 'development' or 'production'
DJANGO_ENV=development

# Django Security Settings
# In production, set a cryptographically secure random string!
SECRET_KEY=django-insecure-local-dev-secret-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# In development: Leave DATABASE_URL commented or empty to default to local SQLite3 (db.sqlite3).
# In production: Provide the PostgreSQL connection string.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/linkedin_career_pilot

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# AI Provider API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# Notification Providers
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Configuration
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@linkedincareerpilot.ai

# Payment Gateway
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Frontend Environment (Vite)
VITE_API_URL=http://127.0.0.1:8000/api/v1
